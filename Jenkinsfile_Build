pipeline{
    agent any
    
    stages{
        stage("Confirm Checkout"){
            steps{
                bat """
                    dir
                    cd TestApp
                    dir
                    echo Source Code checkout successful
                """
            }
        }
        stage("Run Tests"){
            steps{
                bat "echo Running tests for TestApp"
            }
        }
        stage("Source code build"){
            steps{
                bat "echo Source code build is done"
            }
        }
        stage("Validate Project Structure"){
            steps{
                bat "echo Project structure validated"
            }
        }
        stage("Deploy to Server"){
            input{
                message "Do you want to deploy the app to server"
                ok "yes"
            }
            steps{
                bat "echo Project deployed to Server"
            }
        }
        stage("Run the app"){
            steps{
                bat "echo App is running"
            }
        }
    }
    post{
        always{
            cleanWs();
            bat "echo Workspace cleaned up"
        }
    }
}
